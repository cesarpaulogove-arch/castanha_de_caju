generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Usuario {
  id                    Int              @id @default(autoincrement())
  nome                  String
  telefone              String           @unique
  senha                 String
  perfil                Perfil
  ativo                 Boolean          @default(true)
  online                Boolean          @default(false)

  latitude              Decimal?         @db.Decimal(10, 7)
  longitude             Decimal?         @db.Decimal(10, 7)
  localizacaoAtualizada DateTime?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  localizacao           String

  comprasComoEntregador Compra[]         @relation("ComprasEntregador")
  fornecimentos         Fornecimento[]
  processamentos        Processamento[]
  producoes             Producao[]
  sessoes               Sessao[]

  @@index([perfil])
  @@index([ativo])
  @@index([online])
}


model Sessao {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  usuarioId Int?
  expiraEm  DateTime
  createdAt DateTime   @default(now())
  tipo      TipoSessao @default(UTILIZADOR)
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@index([tipo])
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String   @unique
  email     String?
  distrito  String?
  bairro    String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  compras   Compra[]

  @@index([nome])
  @@index([telefone])
  @@index([ativo])
}

model Produto {
  id              Int              @id @default(autoincrement())
  nome            String
  descricao       String?
  unidade         String           @default("kg")
  ativo           Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fornecimentos   Fornecimento[]
  itensCompra     ItemCompra[]
  movimentosStock MovimentoStock[]
  processamentos  Processamento[]
  producoes       Producao[]
  stock           Stock?

  @@index([nome])
  @@index([ativo])
}

model Producao {
  id                   Int              @id @default(autoincrement())
  produtorId           Int
  produtoId            Int
  lote                 String           @unique
  quantidade           Decimal          @db.Decimal(12, 3)
  quantidadeDisponivel Decimal          @db.Decimal(12, 3)
  dataProducao         DateTime         @default(now())
  estado               EstadoOperacao   @default(PENDENTE)
  confirmadoEm         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  movimentosStock      MovimentoStock[]
  produto              Produto          @relation(fields: [produtoId], references: [id])
  produtor             Usuario          @relation(fields: [produtorId], references: [id])

  @@index([produtorId])
  @@index([produtoId])
  @@index([produtorId, dataProducao])
  @@index([lote])
  @@index([estado])
}

model Fornecimento {
  id                   Int              @id @default(autoincrement())
  fornecedorId         Int
  produtoId            Int
  lote                 String           @unique
  quantidade           Decimal          @db.Decimal(12, 3)
  quantidadeDisponivel Decimal          @db.Decimal(12, 3)
  dataFornecimento     DateTime         @default(now())
  estado               EstadoOperacao   @default(PENDENTE)
  confirmadoEm         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  fornecedor           Usuario          @relation(fields: [fornecedorId], references: [id])
  produto              Produto          @relation(fields: [produtoId], references: [id])
  movimentosStock      MovimentoStock[]

  @@index([fornecedorId])
  @@index([produtoId])
  @@index([fornecedorId, dataFornecimento])
  @@index([lote])
  @@index([estado])
}

model Processamento {
  id                   Int              @id @default(autoincrement())
  processadorId        Int
  produtoId            Int
  lote                 String           @unique
  quantidade           Decimal          @db.Decimal(12, 3)
  quantidadeDisponivel Decimal          @db.Decimal(12, 3)
  dataProcessamento    DateTime         @default(now())
  estado               EstadoOperacao   @default(PENDENTE)
  confirmadoEm         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  movimentosStock      MovimentoStock[]
  processador          Usuario          @relation(fields: [processadorId], references: [id])
  produto              Produto          @relation(fields: [produtoId], references: [id])

  @@index([processadorId])
  @@index([produtoId])
  @@index([processadorId, dataProcessamento])
  @@index([lote])
  @@index([estado])
}

model Stock {
  id         Int      @id @default(autoincrement())
  produtoId  Int      @unique
  quantidade Decimal  @default(0) @db.Decimal(12, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  produto    Produto  @relation(fields: [produtoId], references: [id])
}

model MovimentoStock {
  id               Int                @id @default(autoincrement())
  produtoId        Int
  quantidade       Decimal            @db.Decimal(12, 3)
  quantidadeAntes  Decimal            @db.Decimal(12, 3)
  quantidadeDepois Decimal            @db.Decimal(12, 3)
  tipo             TipoMovimentoStock
  producaoId       Int?
  fornecimentoId   Int?
  processamentoId  Int?
  gestorEmail      String?
  descricao        String?
  createdAt        DateTime           @default(now())
  fornecimento     Fornecimento?      @relation(fields: [fornecimentoId], references: [id], onDelete: Restrict)
  processamento    Processamento?     @relation(fields: [processamentoId], references: [id], onDelete: Restrict)
  producao         Producao?          @relation(fields: [producaoId], references: [id], onDelete: Restrict)
  produto          Produto            @relation(fields: [produtoId], references: [id])

  @@index([produtoId, createdAt])
  @@index([producaoId])
  @@index([fornecimentoId])
  @@index([processamentoId])
}

model Compra {
  id                 Int          @id @default(autoincrement())
  clienteId          Int?
  nomeCliente        String
  telefoneCliente    String
  distritoEntrega    String?
  bairroEntrega      String?
  latitudeEntrega    Decimal?     @db.Decimal(10, 7)
  longitudeEntrega   Decimal?     @db.Decimal(10, 7)
  entregadorId       Int?
  nomeEntregador     String?
  telefoneEntregador String?
  subtotal           Decimal      @db.Decimal(12, 2)
  desconto           Decimal      @default(0) @db.Decimal(12, 2)
  taxaEntrega        Decimal      @default(0) @db.Decimal(12, 2)
  total              Decimal      @db.Decimal(12, 2)
  quantidadeTotalKg  Decimal      @db.Decimal(12, 3)
  estado             EstadoCompra @default(PENDENTE)
  dataCompra         DateTime     @default(now())
  confirmadaEm       DateTime?
  concluidaEm        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  cliente            Cliente?     @relation(fields: [clienteId], references: [id])
  entregador         Usuario?     @relation("ComprasEntregador", fields: [entregadorId], references: [id])
  itens              ItemCompra[]

  @@index([clienteId])
  @@index([entregadorId])
  @@index([estado])
  @@index([dataCompra])
  @@index([telefoneCliente])
  @@index([nomeCliente])
  @@index([distritoEntrega])
  @@index([bairroEntrega])
}

model ItemCompra {
  id            Int      @id @default(autoincrement())
  compraId      Int
  produtoId     Int
  produtoNome   String
  quantidade    Decimal  @db.Decimal(12, 3)
  precoUnitario Decimal  @db.Decimal(12, 2)
  desconto      Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produto       Produto  @relation(fields: [produtoId], references: [id])

  @@index([compraId])
  @@index([produtoId])
}


model VerificacaoEmail {
  id          String   @id @default(cuid())
  email       String
  codigoHash  String
  expiraEm    DateTime
  tentativas  Int      @default(0)
  verificado  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([expiraEm])
}



enum Perfil {
  PRODUTOR
  CLIENTE
  ENTREGADOR
  FORNECEDOR
  PROCESSADOR
  TRANSPORTADOR
  GESTOR
}

enum TipoSessao {
  UTILIZADOR
  GESTOR
}

enum EstadoOperacao {
  PENDENTE
  CONFIRMADO
  REJEITADO
}

enum TipoMovimentoStock {
  ENTRADA_PRODUCAO
  ENTRADA_FORNECIMENTO
  ENTRADA_PROCESSAMENTO
  SAIDA
  AJUSTE
}
enum EstadoCompra {
  PENDENTE
  CONFIRMADA
  EM_PREPARACAO
  EM_ENTREGA
  ENTREGUE
  CONCLUIDA
  CANCELADA
}