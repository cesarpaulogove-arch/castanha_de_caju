generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  GESTOR
  PRODUTOR
  CLIENTE
  ENTREGADOR
  FORNECEDOR
  PROCESSADOR
  TRANSPORTADOR
}

enum TipoSessao {
  UTILIZADOR
  GESTOR
}

enum EstadoOperacao {
  PENDENTE
  CONFIRMADO
  REJEITADO
}

enum TipoMovimentoStock {
  ENTRADA_PRODUCAO
  ENTRADA_FORNECIMENTO
  ENTRADA_PROCESSAMENTO
  SAIDA
  AJUSTE
}

enum EstadoCompra {
  PENDENTE
  CONFIRMADA
  EM_PREPARACAO
  EM_ENTREGA
  CONCLUIDA
  CANCELADA
}

model Usuario {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  telefone    String?
  localizacao String
  senha       String
  perfil      Perfil
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessoes        Sessao[]
  producoes      Producao[]
  fornecimentos  Fornecimento[]
  processamentos Processamento[]

  comprasComoCliente    Compra[] @relation("ComprasCliente")
  comprasComoEntregador Compra[] @relation("ComprasEntregador")

  @@index([perfil])
}

model Sessao {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  usuarioId Int?
  tipo      TipoSessao @default(UTILIZADOR)
  expiraEm  DateTime
  createdAt DateTime   @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@index([tipo])
}

model Produto {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  unidade   String   @default("kg")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Produção
  producoes Producao[]

  // Fornecimentos
  fornecimentos Fornecimento[]

  // Processamentos
  processamentos Processamento[]

  // Stock atual
  stock Stock?

  // Histórico de movimentos
  movimentosStock MovimentoStock[]

  // Itens vendidos
  itensCompra ItemCompra[]

  @@index([nome])
  @@index([ativo])
}

model Producao {
  id         Int @id @default(autoincrement())
  produtorId Int
  produtoId  Int

  lote String @unique

  quantidade Decimal @db.Decimal(12, 3)

  quantidadeDisponivel Decimal @db.Decimal(12, 3)

  dataProducao DateTime @default(now())

  estado EstadoOperacao @default(PENDENTE)

  confirmadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtor Usuario @relation(fields: [produtorId], references: [id], onDelete: Restrict)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  movimentosStock MovimentoStock[]

  @@index([produtorId])
  @@index([produtoId])
  @@index([produtorId, dataProducao])
  @@index([lote])
  @@index([estado])
}

model Fornecimento {
  id           Int @id @default(autoincrement())
  fornecedorId Int
  produtoId    Int

  lote String @unique

  quantidade Decimal @db.Decimal(12, 3)

  quantidadeDisponivel Decimal @db.Decimal(12, 3)

  dataFornecimento DateTime @default(now())

  estado EstadoOperacao @default(PENDENTE)

  confirmadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fornecedor Usuario @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  movimentosStock MovimentoStock[]

  @@index([fornecedorId])
  @@index([produtoId])
  @@index([fornecedorId, dataFornecimento])
  @@index([lote])
  @@index([estado])
}

model Processamento {
  id            Int @id @default(autoincrement())
  processadorId Int
  produtoId     Int

  lote String @unique

  quantidade Decimal @db.Decimal(12, 3)

  quantidadeDisponivel Decimal @db.Decimal(12, 3)

  dataProcessamento DateTime @default(now())

  estado EstadoOperacao @default(PENDENTE)

  confirmadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processador Usuario @relation(fields: [processadorId], references: [id], onDelete: Restrict)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  movimentosStock MovimentoStock[]

  @@index([processadorId])
  @@index([produtoId])
  @@index([processadorId, dataProcessamento])
  @@index([lote])
  @@index([estado])
}

model Stock {
  id Int @id @default(autoincrement())

  produtoId Int @unique

  quantidade Decimal @default(0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)
}

model MovimentoStock {
  id Int @id @default(autoincrement())

  produtoId Int

  quantidade       Decimal @db.Decimal(12, 3)
  quantidadeAntes  Decimal @db.Decimal(12, 3)
  quantidadeDepois Decimal @db.Decimal(12, 3)

  tipo TipoMovimentoStock

  producaoId      Int?
  fornecimentoId  Int?
  processamentoId Int?

  gestorEmail String?
  descricao   String?

  createdAt DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  producao Producao? @relation(fields: [producaoId], references: [id], onDelete: Restrict)

  fornecimento Fornecimento? @relation(fields: [fornecimentoId], references: [id], onDelete: Restrict)

  processamento Processamento? @relation(fields: [processamentoId], references: [id], onDelete: Restrict)

  @@index([produtoId, createdAt])
  @@index([producaoId])
  @@index([fornecimentoId])
  @@index([processamentoId])
}

model Compra {
  id                 Int          @id @default(autoincrement())
  clienteId          Int?
  nomeCliente        String
  telefoneCliente    String
  distritoEntrega    String?
  bairroEntrega      String?
  latitudeEntrega    Decimal?     @db.Decimal(10, 7)
  longitudeEntrega   Decimal?     @db.Decimal(10, 7)
  entregadorId       Int?
  subtotal           Decimal      @db.Decimal(12, 2)
  desconto           Decimal      @db.Decimal(12, 2) @default(0)
  taxaEntrega        Decimal      @db.Decimal(12, 2) @default(0)
  total              Decimal      @db.Decimal(12, 2)
  quantidadeTotalKg  Decimal      @db.Decimal(12, 3)
  estado             EstadoCompra @default(PENDENTE)
  dataCompra         DateTime     @default(now())
  confirmadaEm      DateTime?
  concluidaEm       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  cliente             Usuario?     @relation("ComprasCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  entregador           Usuario?     @relation("ComprasEntregador", fields: [entregadorId], references: [id], onDelete: SetNull)

  itens               ItemCompra[]

  @@index([clienteId])
  @@index([entregadorId])
  @@index([estado])
  @@index([dataCompra])
}

model ItemCompra {
  id Int @id @default(autoincrement())

  compraId  Int
  produtoId Int

  // Nome do produto no momento da compra.
  // Mantém histórico mesmo que o nome do produto seja alterado.
  produtoNome String

  quantidade Decimal @db.Decimal(12, 3)

  precoUnitario Decimal @db.Decimal(12, 2)

  desconto Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  // =========================================================
  // RELAÇÕES
  // =========================================================

  compra Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([compraId])
  @@index([produtoId])
}
